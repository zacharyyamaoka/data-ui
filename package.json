{
  "name": "data-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A drop-in kit for viewing any data: framework-free custom elements (<data-views>, <data-facets>, <data-value>), one view grammar (Obsidian Bases .base files, Vega-Lite inside chart:) and --data-* tokens that default to shadcn's names.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "data-ui": "bin/data-ui.mjs"
  },
  "exports": {
    ".": "./dist/data-ui.js",
    "./data-ui.css": "./dist/data-ui.css",
    "./kpi": "./dist/views/kpi.js",
    "./grammar": "./packages/core/src/grammar.js",
    "./base": "./packages/core/src/base.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node tools/test-all.mjs",
    "test:unit": "node --test tests/unit/ tools/facets.test.mjs",
    "test:browser": "node tools/test-all.mjs --browser-only",
    "serve": "node tools/serve.mjs",
    "check": "node bin/data-ui.mjs check",
    "bench": "node bench/run.mjs",
    "deploy": "node tools/release-check.mjs",
    "publish:site": "node tools/publish-site.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@dagrejs/dagre": "3.1.3",
    "@event-calendar/build": "5.18.1",
    "@protomaps/basemaps": "5.7.2",
    "@tanstack/table-core": "9.3.1",
    "@tanstack/virtual-core": "3.19.7",
    "@turf/turf": "7.4.0",
    "@xyflow/react": "12.12.0",
    "ajv": "8.18.0",
    "d3-hierarchy": "3.1.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "gridstack": "14.0.0",
    "h3-js": "4.5.0",
    "img-comparison-slider": "8.0.7",
    "maplibre-gl": "6.16.0",
    "mermaid": "12.2.0",
    "photoswipe": "5.4.4",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-statistics": "7.12.1",
    "terra-draw": "1.37.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "three": "0.186.1",
    "uplot": "1.6.32",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "vis-timeline": "8.5.5"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
