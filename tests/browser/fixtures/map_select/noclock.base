# tests/browser/map_select_checks.py: a dashboard with no clock: has nothing to keep time with: the bar plays by its own speed
data: stops.json
layout:
  panels:
    - { view: Map, w: 12, h: 6 }
views:
  - type: map
    name: Map
    coordinates: at
    time: { property: when, format: date }
    layers:
      - { type: points, radius: 7, title: Stops }
