# tests/browser/map_select_checks.py: a catchment is the pick of its rows
data: places.json
layout:
  panels:
    - { view: Map, w: 12, h: 6 }
views:
  - type: map
    name: Map
    select: name
    coordinates: at
    layers:
      - { type: catchments, of: 'kind == "site"', count: 'kind == "demand"', title: Catchments }
