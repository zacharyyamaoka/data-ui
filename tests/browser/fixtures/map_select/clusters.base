# tests/browser/map_select_checks.py: a cluster zooms and a row in it is marked over it
data: places.json
layout:
  panels:
    - { view: Map, w: 12, h: 6 }
views:
  - type: map
    name: Map
    select: name
    coordinates: at
    layers:
      - { type: points, radius: 7, cluster: { radius: 40 }, title: Places }
