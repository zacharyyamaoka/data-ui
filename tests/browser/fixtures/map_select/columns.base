# tests/browser/map_select_checks.py: a raised hexagon
data: places.json
layout:
  panels:
    - { view: Map, w: 12, h: 6 }
views:
  - type: map
    name: Map
    select: name
    coordinates: at
    pitch: 30
    layers:
      - { type: hexbin, resolution: 5, extrude: { max: 20000 }, title: Columns }
