# tests/browser/map_select_checks.py: no select:, as before: a click opens the peek and highlights what was clicked
data: places.json
layout:
  panels:
    - { view: Map, w: 12, h: 6 }
views:
  - type: map
    name: Map
    coordinates: at
    layers:
      - { type: regions, geometry: zones.geojson, key: id, join: zone, title: Zones }
