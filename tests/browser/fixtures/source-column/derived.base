# A made-up servo whose datasheet derives some values (decoded from its model code, as RobotParts' JMC pole pairs are):
# the Nominal source column names the source a derived value came from, with a quiet "derived" mark, and "—" only where
# nothing names one (tests/browser/source_derived_checks.py, CONTRACT §36)
data: derived.json
views:
  - type: table
    name: Datasheet
    order: [field, nominal]
    units: inline
