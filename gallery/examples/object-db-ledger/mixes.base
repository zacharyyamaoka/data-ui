# Proposal 2 · Table-first: ~/bam-waste-objects/views/Mixes.base (bam-waste-objects @ 3a3be7a, written by
# `object-db bases`), read by data-ui. The verbatim file is library/Mixes.base; the edits are marked EDIT below.
# Check it: node bin/data-ui.mjs check gallery/examples/object-db-ledger/mixes.base
data: ../object-db-shelf/mix_list.json   # EDIT 1 (added): data-ui reads a data file; Obsidian reads the vault's notes
filters:
  and:
    # EDIT 2 (commented out): - file.inFolder("mixes")  data-ui has no vault folders; the data file IS that folder
    - 'kind == "mix"'
properties:
  note.name:
    displayName: "Name"
views:
  - type: table
    name: "Mixes"
    order:
      - name
      - basis
      - measured
      - tags
      - source
    sort:
      - property: name
        direction: ASC
