# Generated by `object-db bases`; running it again overwrites this file.
filters:
  and:
    - file.inFolder("mixes")
    - 'kind == "mix"'
properties:
  note.name:
    displayName: "Name"
views:
  - type: table
    name: "Mixes"
    order:
      - name
      - basis
      - measured
      - tags
      - source
    sort:
      - property: name
        direction: ASC
