# Generated by `object-db bases`; running it again overwrites this file.
filters:
  and:
    - file.inFolder("types")
    - 'kind == "type"'
formulas:
  instances: 'file.backlinks.filter(value.asFile().inFolder("objects")).length'
properties:
  note.name:
    displayName: "Name"
  note.typical_mass_g:
    displayName: "Typical mass (g)"
  formula.instances:
    displayName: "Instances"
views:
  - type: table
    name: "Types"
    order:
      - name
      - material
      - form
      - colour
      - grade
      - typical_mass_g
      - formula.instances
    sort:
      - property: name
        direction: ASC
    summaries:
      formula.instances: Sum
