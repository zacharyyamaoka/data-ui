# Generated by `object-db bases`; running it again overwrites this file.
filters:
  and:
    - file.inFolder("materials")
    - 'kind == "material"'
properties:
  note.name:
    displayName: "Name"
  note.resin_code:
    displayName: "Resin code"
  note.density_g_cm3:
    displayName: "Density (g/cm3)"
  note.spectral_range_nm:
    displayName: "Spectral range (nm)"
  note.spectral_source:
    displayName: "Spectral source"
views:
  - type: table
    name: "Materials"
    order:
      - name
      - family
      - resin_code
      - density_g_cm3
      - spectral_range_nm
      - spectral_source
    sort:
      - property: family
        direction: ASC
      - property: name
        direction: ASC
