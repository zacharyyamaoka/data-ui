# Generated by `object-db bases`; running it again overwrites this file.
filters:
  and:
    - file.inFolder("objects")
    - 'kind == "instance"'
properties:
  note.name:
    displayName: "Name"
  note.mass_g:
    displayName: "Mass (g)"
  note.size_class:
    displayName: "Size class"
  note.geometry_class:
    displayName: "Geometry"
views:
  - type: cards
    name: "Cards"
    groupBy:
      property: type
      direction: ASC
    order:
      - name
      - material
      - form
      - mass_g
    image: note.thumbnail
    imageFit: contain
    cardSize: 170
    sort:
      - property: name
        direction: ASC
  - type: table
    name: "Table"
    order:
      - name
      - type
      - material
      - form
      - colour
      - size_class
      - geometry_class
      - mass_g
      - source
    sort:
      - property: name
        direction: ASC
  - type: cards
    name: "Real scans"
    filters:
      or:
        - 'source == "graspclutter6d"'
        - 'source == "graspnet1b"'
    groupBy:
      property: type
      direction: ASC
    order:
      - name
      - material
      - form
      - mass_g
    image: note.thumbnail
    imageFit: contain
    cardSize: 170
    sort:
      - property: name
        direction: ASC
  - type: cards
    name: "Soft twins"
    filters:
      or:
        - 'soft_kind == "cloth"'
        - 'soft_kind == "film"'
        - 'soft_kind == "shell"'
    groupBy:
      property: type
      direction: ASC
    order:
      - name
      - material
      - form
      - mass_g
    image: note.soft_thumbnail
    imageFit: contain
    cardSize: 170
    sort:
      - property: name
        direction: ASC
