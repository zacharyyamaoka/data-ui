# Generated by `object-db bases`; running it again overwrites this file.
filters:
  and:
    - file.inFolder("objects")
    - 'kind == "instance"'
properties:
  note.name:
    displayName: "Name"
  note.mass_g:
    displayName: "Mass (g)"
views:
  - type: cards
    name: "By material"
    groupBy:
      property: material
      direction: ASC
    order:
      - name
      - material
      - form
      - mass_g
    image: note.thumbnail
    imageFit: contain
    cardSize: 170
    sort:
      - property: name
        direction: ASC
