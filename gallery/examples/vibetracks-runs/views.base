# Vibe Tracks' run explorer: the run is the atomic record, and the table, the pivot and the leaderboard are views over
# that one dataset (Zach, Oct 11). The check runs of every track, linked to the track tree so the leaderboard is the
# tree's roll-up. Data: ../vibetracks-dashboard (real, source/build.py there). Grammar: docs/peps/0004-dashboards.md.
data: ../vibetracks-dashboard/runs.json
facets:
  - track_title
  - kind
  - channel
  - { property: t, as: date, label: Run date }
  - { property: pass_rate, as: slider-histogram, label: Pass rate of the run }
properties:
  track_title: { displayName: Track }
  t: { displayName: When }
  kind: { displayName: Kind }
  pass_rate: { displayName: Pass rate, digits: 3 }
  title: { displayName: Track }
  checks_passed: { displayName: Passing }
  checks_run: { displayName: Checks }
  passed: { displayName: Passed }
  checks: { displayName: Checks }
# the same hue per run kind as the track overview (vibetracks-dashboard), in every panel here
style:
  chrome: minimal
  numbers: { digits: 3, compact: true }
  palette: { tests: "#2a78d6", checks: "#19a979", goldens: "#d4a72c", gates: "#a259d9" }
datasets:
  runs: ../vibetracks-dashboard/runs.json
  tracks:
    data: ../vibetracks-dashboard/tracks.json
    tree: { parent: parent }
    facets: [area]
    rollup:
      from: runs
      latest: { by: t, per: suite }
      values:
        checks_passed: { property: passed, summary: Sum }
        checks_run: { property: checks, summary: Sum }
        pass_rate: { property: passed, summary: Ratio, per: checks }
links:
  - { from: runs.track, to: tracks.id }
layout:
  panels:
    - text: |
        ## Runs in, numbers out
        Every row below is one run a producer wrote. The cards are **Σ passed / Σ checks** over the runs the rail keeps
        (a ratio of sums, never a mean of ratios); the leaderboard is each track's newest run per suite, rolled up
        through its children. Click a point or a leader to narrow everything; click a run to open it.
      w: 12
    - { view: Pass rate by kind, w: 12 }
    - { view: Checks passing, w: 3, h: 3 }
    - { view: Runs per week, w: 6, h: 3 }
    - { view: Check runs per track, w: 3, h: 3 }
    - { view: Every run over time, w: 8, h: 5 }
    - { view: Leaderboard, w: 4, h: 5 }
    - { views: [Runs, Track × kind, By track], title: The runs, w: 12, h: 6, toolbar: full }
views:
  - type: kpi
    name: Pass rate by kind
    groupBy: { property: kind }
    groupOrder: [tests, checks, goldens, gates]
    sort:
      - { property: t, direction: ASC }
    kpi:
      value: { property: passed, summary: Ratio, per: checks }
      spark: { x: t, y: pass_rate }
      format: { digits: 3, compact: true }
  # WHY a bar, not an arc: this ratio sits near 1, and the arc gauge draws a fill past half the long way round
  # (stat-model.js arcPath's large-arc flag; reported to the cards lane), so the bar is the shape that is right today
  - type: gauge
    name: Checks passing
    gauge:
      value: { property: passed, summary: Ratio, per: checks }
      min: 0
      max: 1
      shape: bar
      better: higher
      label: Σ passed / Σ checks over the runs kept
      bands: [{ to: 0.9, tone: bad }, { to: 0.99, tone: warn }, { tone: good }]
  - type: chart
    name: Runs per week
    # no mark: a count over weeks is a line (Zach, 2026-10-26; docs/SPEC.md §8.5), one line per run kind
    chart:
      encoding:
        x: { field: t, by: week, title: null, axis: { labelAngle: 0 } }
        y: { aggregate: count, title: Runs }
        color: { field: kind, title: Kind }
    hover: { title: run, fields: [track_title, suite, passed, checks] }
  - type: barlist
    name: Check runs per track
    select: track
    barlist: { label: track_title, value: { property: checks, summary: Count }, limit: 6 }
  - type: chart
    name: Every run over time
    select: track
    chart:
      mark: { type: point, filled: true, size: 60 }
      encoding:
        x: { field: t, title: null }
        y: { field: pass_rate, title: Pass rate of the run, scale: { domain: [0, 1] } }
        # WHY the track legend below in columns and the kind legend on top: in one row they ran past the tile's edge
        color: { field: track_title, title: Track, legend: { orient: bottom, columns: 3 } }
        shape: { field: kind, title: Kind, legend: { orient: top } }
    hover: { title: run, fields: [track_title, suite, passed, checks, branch] }
  - type: table
    name: Leaderboard
    from: tracks
    select: id
    filters: '!checks_run.isEmpty()'
    order: [title, pass_rate, checks_passed, checks_run]
    sort:
      - { property: pass_rate, direction: DESC }
  - type: table
    name: Runs
    order: [t, track_title, suite, kind, passed, failed, skipped, checks, pass_rate, seconds, channel, branch, sha]
    sort:
      - { property: t, direction: DESC }
  - type: pivot
    name: Track × kind
    groupBy: { property: track_title }
    splitBy: [kind]
    value: { property: checks, summary: Sum }
  - type: table
    name: By track
    order: [t, suite, kind, passed, checks, pass_rate, branch]
    groupBy: { property: track_title }
    sort:
      - { property: t, direction: DESC }
    summaries: { passed: Sum, checks: Sum, pass_rate: Median }
    fold: closed
