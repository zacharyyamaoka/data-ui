# Actuators: every view of one table of data in one file (docs/SPEC.md §5). The five table views are the table lane's
# presets (robotparts lane/tables @ ab5ba92, design/tables-2026-10-25/presets/actuators.base), unchanged. The cards
# and chart views are data-ui's proposal. Obsidian Bases grammar: Obsidian keeps every key it doesn't know.
#   Check it:  python3 tools/check_views.py examples/actuators.base --data examples/actuators.schema.json
data: actuators.schema.json
facets:
  - brand
  - form
  - drivetrain
  - buses
  - level
  - { property: peak_torque, as: range }
  - { property: mass, as: range }
  - { property: price, as: range }
properties:
  model: { displayName: Model }
  brand: { displayName: Brand }
  form: { displayName: Form }
  drivetrain: { displayName: Drivetrain }
  peak_torque: { displayName: Peak torque }
  rated_torque: { displayName: Rated torque }
  max_speed: { displayName: Max speed }
  mass: { displayName: Mass }
  gear_ratio: { displayName: Ratio }
  voltage: { displayName: Voltage }
  od: { displayName: OD }
  length: { displayName: Length }
  buses: { displayName: Bus }
  torque_density: { displayName: Peak N·m/kg }
  price: { displayName: Price from }
  sellers: { displayName: Sellers }
  level: { displayName: Level }
views:
  # ---- the table lane's views, verbatim ---------------------------------------------------------------------
  - type: table
    name: By brand
    order: [model, form, peak_torque, rated_torque, max_speed, mass, gear_ratio, voltage, od, length, buses, price]
    groupBy: { property: brand, direction: ASC }
    sort:
      - { property: peak_torque, direction: DESC }
    summaries: { peak_torque: Max, mass: Min, price: Min }
  - type: table
    name: Brand › form
    order: [model, peak_torque, mass, gear_ratio, voltage, price]
    groupBy: { property: brand, direction: ASC }
    subGroupBy: { property: form, direction: ASC }
    sort:
      - { property: peak_torque, direction: DESC }
    summaries: { peak_torque: Max, price: Min }
    fold: closed
  - type: table
    name: Torque density
    filters: '!torque_density.isEmpty()'
    order: [model, brand, torque_density, peak_torque, mass, price]
    sort:
      - { property: torque_density, direction: DESC }
    display: { torque_density: bar }
  - type: table
    name: Geared CAN under $150
    filters:
      and:
        - 'drivetrain == "geared"'
        - 'buses.contains("can")'
        - 'price < 150'
    order: [model, brand, price, peak_torque, mass, gear_ratio, voltage]
    sort:
      - { property: price, direction: ASC }
    display: { price: bar }
  - type: table
    name: All, flat
    order: [model, brand, form, drivetrain, peak_torque, rated_torque, max_speed, mass, gear_ratio, voltage, od, length, buses, torque_density, price, sellers, level]
    sort:
      - { property: brand, direction: ASC }
      - { property: model, direction: ASC }

  # ---- cards: Bases' own cards keys (read from Obsidian 1.14.5: image, imageFit, imageAspectRatio, cardSize) ---------
  - type: cards
    name: Gallery
    order: [model, brand, peak_torque, mass, price]
    image: photo
    imageFit: contain
    imageAspectRatio: 0.75
    cardSize: 220
    sort:
      - { property: peak_torque, direction: DESC }

  # ---- charts: inside `chart:` the vocabulary is Vega-Lite's; data-ui adds the filtered rows and the theme ---------
  - type: chart
    name: Torque vs mass
    chart:
      mark: { type: point, filled: true }
      encoding:
        x: { field: mass, scale: { type: log }, title: Mass (g) }
        y: { field: peak_torque, scale: { type: log }, title: Peak torque (N·m) }
        color: { field: brand }
        tooltip: [{ field: model }, { field: peak_torque }, { field: mass }, { field: price }]
    hover: { image: photo, title: name }
  - type: chart
    name: Density vs price
    filters: '!torque_density.isEmpty() && !price.isEmpty()'
    chart:
      mark: point
      encoding:
        x: { field: price, scale: { type: log }, title: Price from (USD) }
        y: { field: torque_density, title: Peak N·m/kg }
        size: { field: peak_torque }
        opacity: { field: level, type: ordinal }
        shape: { field: drivetrain }
    hover: { image: photo, title: name, fields: [peak_torque, mass, price, sellers] }
  - type: chart
    name: Ashby · torque vs mass
    chart:
      mark: { type: point, filled: true, size: 18 }
      encoding:
        x: { field: mass, scale: { type: log }, title: Mass (g) }
        y: { field: peak_torque, scale: { type: log }, title: Peak torque (N·m) }
        color: { field: drivetrain }
    guides:
      - { envelope: drivetrain, shape: hull }
      - { indexLine: { slope: 1, through: median }, label: "constant N·m per g (torque density)" }
      - { rule: { y: 10 }, label: "10 N·m reference" }
    hover: { image: photo, title: name }
  - type: chart
    name: Torque by drivetrain, a row per form
    filters: 'level >= 3'
    chart:
      mark: tick
      encoding:
        x: { field: peak_torque, scale: { type: log } }
        y: { field: drivetrain }
        row: { field: form }
